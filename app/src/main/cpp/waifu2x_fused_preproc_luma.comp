#version 450

// SY --> mihon-webdav: 单通道（luma）模型的融合预处理。
//
// 与 3 通道版（waifu2x_fused_preproc.comp）唯一的差别是「输出几个平面」：
// 3 通道版把打包的 RGBA8 拆成 3 个平面（B,G,R），这里只输出 1 个平面 ——
// BT.601 亮度 Y = (0.299*R + 0.587*G + 0.114*B) / 255。
//
// 这与 CPU staged 路径的 luma_normalized 逐字一致（见 waifu2x.cpp:luma 分支），
// 也正好对上 Anime4K v4 ACNet 的输入定义（1 通道、0..1）。
//
// 边界处理与 3 通道版相同：clamp 取最近像素，等价于 CPU 侧的 BORDER_REPLICATE。
// SY <--

#ifdef FUSED_FP16
#extension GL_EXT_shader_16bit_storage : require
#define storage_t float16_t
#else
#define storage_t float
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer bottom_blob {
    float bottom_blob_data[];
};
layout(std430, binding = 1) writeonly buffer top_blob {
    storage_t top_blob_data[];
};

layout(push_constant) uniform parameter {
    int w;
    int h;
    int cstep;
    int outw;
    int outh;
    int outcstep;
    int pad_top;
    int pad_left;
    int crop_x;
    int crop_y;
    int channels;
    int alphaw;
    int alphah;
} p;

void main() {
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    if (gx >= p.outw || gy >= p.outh) return;

    int x = clamp(gx + p.crop_x - p.pad_left, 0, p.w - 1);
    int y = clamp(gy + p.crop_y - p.pad_top, 0, p.h - 1);
    uint packed_pixel = floatBitsToUint(bottom_blob_data[y * p.w + x]);
    // 打包顺序是 byte0=R byte1=G byte2=B byte3=A（AndroidBitmap RGBA_8888）
    float r = float(packed_pixel & 255u);
    float g = float((packed_pixel >> 8) & 255u);
    float b = float((packed_pixel >> 16) & 255u);
    float luma = (0.299 * r + 0.587 * g + 0.114 * b) * (1.0 / 255.0);
    top_blob_data[gy * p.outw + gx] = storage_t(luma);
}
